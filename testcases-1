import ast
import subprocess

# AI-generated Python code
code = """
def add(a: int, b: int) -> int:
    return a + b

print(add(10, 20))
"""

# Save code
with open("generated.py", "w") as f:
    f.write(code)

score = 0

# 1. AST Syntax Checking
try:
    ast.parse(code)
    print("AST Syntax Check: Passed")
    score += 20
except SyntaxError:
    print("AST Syntax Check: Failed")

# 2. Pylint Static Analysis
p = subprocess.run(
    ["pylint", "generated.py"],
    capture_output=True, text=True
)
print("\nPylint Analysis:\n", p.stdout)
if p.returncode == 0:
    score += 20

# 3. Mypy Type Checking
m = subprocess.run(
    ["mypy", "generated.py"],
    capture_output=True, text=True
)
print("\nMypy Analysis:\n", m.stdout)
if m.returncode == 0:
    score += 20

# 4. Execution Testing
e = subprocess.run(
    ["python", "generated.py"],
    capture_output=True, text=True
)
print("\nExecution Output:", e.stdout.strip())
if e.returncode == 0:
    score += 20

# 5. Pytest Dynamic Testing
test_code = """
from generated import add

def test_add():
    assert add(2, 3) == 5

def test_add_negative():
    assert add(-2, -3) == -5
"""

with open("test_generated.py", "w") as f:
    f.write(test_code)

t = subprocess.run(
    ["pytest", "-q", "test_generated.py"],
    capture_output=True, text=True
)
print("\nPytest Results:\n", t.stdout)
if t.returncode == 0:
    score += 20

# 6. Quality Score
print("Quality Score:", score, "/100")

# 7. Improvement Suggestions
if score == 100:
    print("Suggestion: Code quality is good.")
else:
    print("Suggestion: Fix syntax, type, or testing errors.")

