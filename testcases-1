from transformers import pipeline
import unittest

# Load GPT-Neo model
model = pipeline("text-generation", model="EleutherAI/gpt-neo-125M")

# Pseudocode examples
problems = {
    "Find Maximum": "Find the largest number in a list.",
    "Check Even Number": "Check whether a number is even.",
    "Calculate Factorial": "Find the factorial of a number.",
    "Calculate Average": "Calculate the average of a list.",
    "Reverse a String": "Reverse the given string."
}

# Generate Python code
for name, task in problems.items():
    prompt = "Write Python code to " + task
    result = model(prompt, max_new_tokens=60, do_sample=False)

    print("\n", name)
    print("Generated Code:\n", result[0]["generated_text"])

# Python functions for testing
def find_max(a):
    return max(a)

def is_even(n):
    return n % 2 == 0

def factorial(n):
    return 1 if n == 0 else n * factorial(n-1)

def average(a):
    return sum(a) / len(a)

def reverse_string(s):
    return s[::-1]

# Unit testing
class TestCode(unittest.TestCase):
    def test_max(self):
        self.assertEqual(find_max([2, 5, 8]), 8)

    def test_even(self):
        self.assertTrue(is_even(4))

    def test_factorial(self):
        self.assertEqual(factorial(5), 120)

    def test_average(self):
        self.assertEqual(average([2, 4, 6]), 4)

    def test_reverse(self):
        self.assertEqual(reverse_string("hello"), "olleh")

unittest.main()


