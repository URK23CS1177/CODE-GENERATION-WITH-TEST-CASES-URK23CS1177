import ollama
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.naive_bayes import MultinomialNB

# Real Python code samples
real = [
    "def add(a,b): return a+b",
    "def square(n): return n*n",
    "def multiply(a,b): return a*b"
]

# Generate code using CodeLlama
response = ollama.generate(
    model="codellama",
    prompt="Write a Python function to find factorial. Return only code."
)

generated = response["response"]
print("Generated Code:\n", generated)

# Prepare dataset
X = real + [generated]
y = [0, 0, 0, 1]  # 0 = Real, 1 = Generated

# Train classifier
vectorizer = CountVectorizer()
X = vectorizer.fit_transform(X)

model = MultinomialNB()
model.fit(X, y)

# Classify generated code
prediction = model.predict(vectorizer.transform([generated]))

print("Classification:",
      "Generated Code" if prediction[0] == 1 else "Real Code")
