from transformers import pipeline
import gradio as gr

# Load GPT-2 model
model = pipeline("text-generation", model="gpt2")

# Code completion function
def complete_code(code):
    result = model(code, max_new_tokens=50)
    return result[0]["generated_text"]

# Gradio interface
demo = gr.Interface(
    fn=complete_code,
    inputs=gr.Textbox(label="Enter Incomplete Code"),
    outputs=gr.Textbox(label="Completed Code"),
    title="AI Code Completion"
)

demo.launch()

