from transformers import pipeline
import gradio as gr

# Load pre-trained GPT-2 model
generator = pipeline("text-generation", model="gpt2")

# Code completion function
def complete_code(code):
    result = generator(
        code,
        max_new_tokens=50,
        num_return_sequences=1,
        pad_token_id=50256,
        do_sample=True,
        temperature=0.7
    )
    return result[0]["generated_text"]

# Create Gradio interface
app = gr.Interface(
    fn=complete_code,
    inputs=gr.Textbox(
        lines=5,
        label="Enter Incomplete Python Code",
        placeholder="def add(a, b):"
    ),
    outputs=gr.Textbox(
        lines=10,
        label="Generated Code Completion"
    ),
    title="AI Code Completion using GPT-2"
)

# Launch application
app.launch()

